{
  "name": "assessment-ai-interview-kit",
  "version": "1.0.0",
  "description": "AI Interview Prep Kit assessment app",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev -p 3000",
    "dev:backend": "node backend/server.js",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "next start -p 3000",
    "start:backend": "node backend/server.js",
    "test": "node --test tests/*.test.js",
    "evaluate": "node scripts/evaluate.js"
  },
  "keywords": [
    "nextjs",
    "ai",
    "interview",
    "assessment"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "nanoid": "^6.0.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
